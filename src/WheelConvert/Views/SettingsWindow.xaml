<Window x:Class="WheelConvert.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WheelConvert — Settings &amp; Guide" Width="680" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#181825" Foreground="#CDD6F4"
        ResizeMode="CanResizeWithGrip" MinWidth="580" MinHeight="480">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="18,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,8,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF7A3D"/>
                                <Setter Property="Foreground" Value="#FF7A3D"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#A6ADC8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,14">
            <Border Width="32" Height="32" CornerRadius="16" Background="#FF7A3D" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="⚙" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WheelConvert" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Radial menu file converter for Windows 10 &amp; 11" FontSize="11" Foreground="#A6ADC8"/>
            </StackPanel>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: SETTINGS -->
            <TabItem Header="⚙ Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,0">
                    <StackPanel>

                        <!-- Hotkey section -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Activation Hotkey" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="The keyboard combination used to pop up the radial menu over selected files." FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HotkeyBox" Grid.Column="0" Height="32" Background="#11111B" Foreground="#FFB86C" BorderBrush="#45475A" Padding="8,5" FontSize="13" FontWeight="Bold"/>
                                    <ComboBox x:Name="PresetHotkeyCombo" Grid.Column="1" Height="32" Margin="8,0,0,0" Width="170" Background="#313244" Foreground="#CDD6F4" SelectionChanged="PresetHotkey_Selected">
                                        <ComboBoxItem Content="Ctrl+Shift+Space (Default)" IsSelected="True"/>
                                        <ComboBoxItem Content="Ctrl+Shift+C"/>
                                        <ComboBoxItem Content="Alt+Shift+Space"/>
                                        <ComboBoxItem Content="Win+Shift+C"/>
                                        <ComboBoxItem Content="Win+Shift+Z"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Output Folder section -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Output Destination" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Where converted or processed files will be saved." FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,10"/>
                                
                                <RadioButton x:Name="SameFolderRadio" Content="Save in the same folder as the original file (Default)" GroupName="DestGroup" IsChecked="True" Foreground="#CDD6F4" Margin="0,0,0,8" Checked="DestRadio_Checked"/>
                                <RadioButton x:Name="CustomFolderRadio" Content="Save to a specific custom folder:" GroupName="DestGroup" Foreground="#CDD6F4" Margin="0,0,0,6" Checked="DestRadio_Checked"/>

                                <Grid Margin="20,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputFolderBox" Grid.Column="0" Height="30" Background="#11111B" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="8,4" IsReadOnly="True"/>
                                    <Button x:Name="BrowseFolderBtn" Grid.Column="1" Content="Browse…" Height="30" Padding="14,0" Margin="8,0,0,0" Background="#313244" Foreground="White" BorderBrush="#45475A" Click="BrowseFolder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Appearance & Size section -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Wheel Appearance &amp; Size" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <TextBlock Text="Customize the diameter and accent color of the radial wheel." FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wheel Diameter:" VerticalAlignment="Center" Foreground="#CDD6F4"/>
                                    <Slider x:Name="WheelSizeSlider" Grid.Column="1" Minimum="260" Maximum="480" Value="360" TickFrequency="20" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="WheelSize_ValueChanged"/>
                                    <TextBlock x:Name="WheelSizeLabel" Grid.Column="2" Text="360 px" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFB86C" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Accent Theme:" VerticalAlignment="Center" Foreground="#CDD6F4"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Width="26" Height="26" Background="#FF7A3D" BorderBrush="White" BorderThickness="2" Margin="0,0,8,0" Tag="#FF7A3D" Click="AccentColor_Click" ToolTip="Sunrise Orange (Default)"/>
                                        <Button Width="26" Height="26" Background="#3B82F6" BorderBrush="#45475A" BorderThickness="1" Margin="0,0,8,0" Tag="#3B82F6" Click="AccentColor_Click" ToolTip="Ocean Blue"/>
                                        <Button Width="26" Height="26" Background="#10B981" BorderBrush="#45475A" BorderThickness="1" Margin="0,0,8,0" Tag="#10B981" Click="AccentColor_Click" ToolTip="Emerald Green"/>
                                        <Button Width="26" Height="26" Background="#8B5CF6" BorderBrush="#45475A" BorderThickness="1" Margin="0,0,8,0" Tag="#8B5CF6" Click="AccentColor_Click" ToolTip="Royal Purple"/>
                                        <Button Width="26" Height="26" Background="#F43F5E" BorderBrush="#45475A" BorderThickness="1" Margin="0,0,8,0" Tag="#F43F5E" Click="AccentColor_Click" ToolTip="Rose Red"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Integration -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="System Options" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Start WheelConvert automatically on Windows startup" Foreground="#CDD6F4" Margin="0,0,0,8"/>
                                <CheckBox x:Name="UseAcrylicCheck" Content="Enable modern Windows Acrylic blur behind the radial menu" Foreground="#CDD6F4"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: USER GUIDANCE / HOW TO USE -->
            <TabItem Header="📖 How to Use">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,0">
                    <StackPanel>

                        <!-- Step by step -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Quick 3-Step Guide" FontSize="15" FontWeight="Bold" Foreground="#FFB86C" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1" FontSize="14" FontWeight="Bold" Foreground="#FF7A3D" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Select Your File(s)" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Open Windows File Explorer and click to highlight any file (or hold Ctrl / drag a box to select multiple files)." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2" FontSize="14" FontWeight="Bold" Foreground="#FF7A3D" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Press Your Hotkey" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Press [ Ctrl + Shift + Space ] on your keyboard. The radial wheel pops up right at your mouse pointer." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="3" FontSize="14" FontWeight="Bold" Foreground="#FF7A3D" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Choose an Action" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Click or hover over any slice on the wheel. Converted files appear right beside the original files." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Available Actions -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Radial Menu Actions Explained" FontSize="15" FontWeight="Bold" Foreground="#FFB86C" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔄 Convert" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="Hover (~400ms) or click to open format options: PNG, JPG, WEBP, PDF, DOCX, TXT. Converts instantly." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✂️ Crop" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="Opens an interactive window where you drag a box over an image and click Crop to save." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🗜️ Compress" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="Re-encodes images at optimized quality to reduce file size while keeping high clarity." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🖼️ Add BG" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="Replaces transparency in PNG/WEBP with clean solid white." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ℹ️ Metadata" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Grid.Column="1" Text="Shows a searchable table of all EXIF tags, dimensions, date taken, and camera details." Foreground="#A6ADC8" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Keyboard Navigation -->
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Keyboard Shortcuts (While Wheel Is Open)" FontSize="15" FontWeight="Bold" Foreground="#FFB86C" Margin="0,0,0,10"/>
                                <TextBlock Text="• Arrow keys (← ↑ → ↓): Rotate and cycle through slices" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                <TextBlock Text="• Enter: Execute the currently highlighted slice" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                <TextBlock Text="• Backspace: Go back to the main wheel (from format picker)" Foreground="#CDD6F4" Margin="0,0,0,4"/>
                                <TextBlock Text="• Esc or Click Outside: Dismiss the wheel menu" Foreground="#CDD6F4"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Padding="0,14,0,0" BorderBrush="#313244" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Padding="20,7" Margin="0,0,10,0" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Click="Close_Click"/>
                <Button Content="Save &amp; Apply" Padding="22,7" Background="#FF7A3D" Foreground="White" FontWeight="Bold" BorderBrush="#FF7A3D" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
