<Window x:Class="WheelConvert.Views.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop Image" Width="780" Height="600" WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" ResizeMode="CanResizeWithGrip">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#CDD6F4" FontSize="13" Margin="0,0,0,8">
            <Run Text="Click and drag to select crop area. " />
            <Run x:Name="DimensionsText" Foreground="#FFB86C" />
        </TextBlock>

        <Border Grid.Row="1" Background="#11111B" BorderBrush="#45475A" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="ImageCanvas" Background="#11111B"
                    MouseLeftButtonDown="Canvas_MouseDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseUp">
                <Image x:Name="Preview" Stretch="Uniform" />
                <!-- Semi-transparent overlay with hole for crop rect -->
                <Rectangle x:Name="SelectionRect" Stroke="#FF7A3D" StrokeThickness="2"
                           StrokeDashArray="4 2" Fill="#30FF7A3D" Visibility="Collapsed" />
            </Canvas>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Padding="20,6" Margin="0,0,8,0" Click="Cancel_Click"
                    Background="#45475A" Foreground="White" BorderBrush="#585B70" />
            <Button x:Name="CropButton" Content="Crop" Padding="20,6" Click="Crop_Click"
                    Background="#FF7A3D" Foreground="White" BorderBrush="#FF7A3D"
                    IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>

