<Window x:Class="WheelConvert.Views.MetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metadata" Width="520" Height="480" WindowStartupLocation="CenterScreen"
        Background="#1E1E2E" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FileNameText" Grid.Row="0" Foreground="#FFB86C" FontSize="14"
                   FontWeight="SemiBold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />

        <DataGrid x:Name="MetadataGrid" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A"
                  RowBackground="#1E1E2E" AlternatingRowBackground="#24243A"
                  HorizontalGridLinesBrush="#313244" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" />
                <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="160" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,10,0,0"
                Padding="20,6" Click="Close_Click" Background="#45475A" Foreground="White"
                BorderBrush="#585B70" />
    </Grid>
</Window>

