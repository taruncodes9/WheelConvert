<Window x:Class="WheelConvert.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WheelConvert" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,0.5" Background="Transparent">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
        </Grid.RenderTransform>
        <Canvas x:Name="WheelCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
